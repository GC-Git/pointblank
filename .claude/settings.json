{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *\"main\"*)",
      "Bash(git push *'main'*)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -* push * main)",
      "Bash(git -* push * main *)",
      "Bash(git -* push *:main*)",
      "Bash(git -* push *--force*)",
      "Bash(git -* push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -* reset *--hard*)",
      "Bash(rm /*)",
      "Bash(rm * /*)",
      "Bash(rm *\"/*)",
      "Bash(rm *'/*)",
      "Bash(rm *~*)",
      "Bash(rm *..*)",
      "Bash(rm *$HOME*)",
      "Bash(rm *C:**)",
      "Bash(rm *c:**)",
      "Bash(rm *D:**)",
      "Bash(rm *d:**)",
      "Bash(rmdir /*)",
      "Bash(rmdir * /*)",
      "Bash(rmdir *\"/*)",
      "Bash(rmdir *'/*)",
      "Bash(rmdir *~*)",
      "Bash(rmdir *..*)",
      "Bash(rmdir *$HOME*)",
      "Bash(rmdir *C:**)",
      "Bash(rmdir *c:**)",
      "Bash(rmdir *D:**)",
      "Bash(rmdir *d:**)",

      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *\"main\"*)",
      "PowerShell(git push *'main'*)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push *--all*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git -* push * main)",
      "PowerShell(git -* push * main *)",
      "PowerShell(git -* push *:main*)",
      "PowerShell(git -* push *--force*)",
      "PowerShell(git -* push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git -* reset *--hard*)",
      "PowerShell(Remove-Item /*)",
      "PowerShell(Remove-Item * /*)",
      "PowerShell(Remove-Item *\"/*)",
      "PowerShell(Remove-Item *'/*)",
      "PowerShell(Remove-Item *~*)",
      "PowerShell(Remove-Item *..*)",
      "PowerShell(Remove-Item *$HOME*)",
      "PowerShell(Remove-Item *$env:**)",
      "PowerShell(Remove-Item *C:**)",
      "PowerShell(Remove-Item *D:**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",
      "Bash(git push)",
      "Bash(git push *HEAD)",
      "PowerShell(git push)",
      "PowerShell(git push *HEAD)",
      "Edit(/.claude/settings*.json)"
    ]
  }
}
