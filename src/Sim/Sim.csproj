<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PointBlank.Sim</RootNamespace>
    <!-- Item 2.12: compile the sim optimised in every configuration. Test runs are almost all sim code, and the sim is
         integer fixed point, so results are the same. DEBUG and Debug.Assert are unaffected. Pass -p:Optimize=false to
         step through it in a debugger. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The fog-of-war boundary: raw state of both sides is internal. Only the tests and the headless
       runner (a sim-side harness, not UI or AI) see it; the game uses World.ViewFor. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sim.Tests" />
    <InternalsVisibleTo Include="runner" />
  </ItemGroup>

  <!-- The debug-overlay truth bridge (PlayerBattle.DebugTruth, CLAUDE.md rule 11) exists only in development builds.
       Listed by name, so any other configuration (Release, ExportRelease, a new one) is closed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'ExportDebug'">
    <DefineConstants>$(DefineConstants);PB_DEV_BUILD</DefineConstants>
  </PropertyGroup>

</Project>
